# PostgreSQL (Supabase: Project Settings → Database → Connection string, chế độ "Transaction pooler")
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:6543/postgres

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
SESSION_SECRET=

# 32 byte base64 để mã hóa token Dayladau: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Vercel Cron gửi kèm header Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Lưu ảnh (Supabase Storage, bucket private)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=loci-photos

# API Dayladau (theo script Apps Script)
DAYLADAU_API_BASE=https://api.dayladau.com

# Tài khoản Admin đầu tiên (dùng cho npm run db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server riêng: app tự đồng bộ Dayladau + cảnh báo + sinh việc dọn phòng, mặc định 30 phút/lần.
# Bỏ dấu # để đổi số phút; đặt 0 để tắt. Trên Vercel không có tác dụng (dùng vercel.json).
# AUTO_SYNC_MINUTES=30
