# PostgreSQL (Supabase: Project Settings → Database → Connection string, chế độ "Transaction pooler")
DATABASE_URL=postgres://postgres:password@db.xxxx.supabase.co:6543/postgres

# Chuỗi ngẫu nhiên >= 32 ký tự: openssl rand -base64 48
SESSION_SECRET=

# 32 byte base64 để mã hóa token Dayladau: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Vercel Cron (hoặc lịch ngoài gọi /api/cron/*) gửi kèm header Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Lưu ảnh (Supabase Storage, bucket private)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=loci-photos

# API Dayladau (theo script Apps Script)
DAYLADAU_API_BASE=https://api.dayladau.com

# Tài khoản Admin đầu tiên (dùng cho npm run db:seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Server riêng (VPS): app tự đồng bộ Dayladau + cảnh báo + sinh việc dọn phòng mỗi N phút. Mặc định TẮT, để máy tính
# chạy thử (npm run dev) không tự đồng bộ vào DB thật. Chỉ đặt trên đúng một server. Trên Vercel không có tác dụng.
# AUTO_SYNC_MINUTES=30

# Đọc email payout Airbnb từ Gmail của NĐT. Không bắt buộc: Admin có thể nhập ngay trên web
# (Payout Airbnb → Cài đặt kết nối Google). Đặt ở đây thì giá trị trong .env được ưu tiên.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Địa chỉ public của app, cần khi chạy sau nginx trên VPS (vd https://app.loci.vn). Để trống thì lấy theo header của request.
# APP_URL=
# Chỉ đặt khi redirect URI khác <APP_URL>/api/gmail/callback
# GOOGLE_REDIRECT_URI=

# Gửi tin Lark (cảnh báo, nhắc duyệt chi phí…) đang tắt; đặt LARK_ENABLED=1 để bật lại
LARK_ENABLED=

# Thông báo đẩy tới điện thoại nhân viên (cảnh báo "Dọn ngay", sự cố được giao).
# Tạo khóa một lần: npx web-push generate-vapid-keys. Đổi khóa thì mọi máy phải bật thông báo lại.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@baocaodau.com
# Cảnh báo dọn phòng 5 phút/lần: GitHub Actions (.github/workflows/cleaning-alerts.yml) gọi /api/cron/cleaning
# với Bearer CLEANING_CRON_TOKEN (đặt cùng giá trị ở Vercel và ở secret của repo). Server riêng (PM2) tự chạy.
CLEANING_CRON_TOKEN=
# Lấy đơn Dayladau 15 phút/lần (6h–24h VN): GitHub Actions (.github/workflows/sync-bookings.yml) gọi /api/cron/sync-bookings.
# Để trống thì dùng chung CLEANING_CRON_TOKEN. Muốn khóa riêng: đặt cùng giá trị ở Vercel và ở secret của repo.
SYNC_CRON_TOKEN=
